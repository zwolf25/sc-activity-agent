{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC Activity Agent",
  "version": "0.4.0",
  "identifier": "com.zackwolf.sc-activity-agent",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SC Activity Agent",
        "width": 1240,
        "height": 820,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/agent-core"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zwolf25/sc-activity-agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMzI2QUFBRUFEMTRFNTMKUldSVFR0SHFxbW95U3dhK3BQVFVNRTZvejhTV0dkNzFYQUI5US9rYzhKRFZPMkI0SmtmZjR3MXkK"
    }
  }
}
